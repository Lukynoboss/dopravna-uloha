# prostredie Pythonu – vytvára sa na každom počítači zvlášť (aplikacia.bat / aplikacia.command)
.venv/
__pycache__/
*.pyc

# veľké a dočasné výsledky simulácie – dajú sa zopakovať zo seedu
vysledky/*.csv
vysledky/*.json
vysledky/*.md
grafy/

# pomocné skripty, ktoré aplikácia nepotrebuje (zostávajú len na tomto počítači)
spusti.bat
spusti.py
zabal.py
test_metody.py

# hotové balíky (zabal.py)
export/

# pracovné poznámky a nastavenia Claude Code (nie sú súčasťou programu)
.claude/
claude/
CLAUDE.md

# skripty na vytvorenie dokumentov (Node.js) a ich podklady – na GitHube sú len hotové .docx
sprava/*.js
sprava/obrazky/
node_modules/

# systémové súbory
.DS_Store
Thumbs.db
~$*
